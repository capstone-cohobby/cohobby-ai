# ---------------------------
# Python 기본
# ---------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc

# 패키지 메타/빌드 산출물
build/
dist/
*.egg-info/
*.egg
*.whl

# ---------------------------
# Poetry / 가상환경
# ---------------------------
# Poetry 자체 캐시는 보통 전역 디렉토리에 있어 커밋될 일 거의 없음
.poetry/

# 프로젝트 내부 가상환경(권장: poetry config virtualenvs.in-project true)
.venv/
.venv*/
venv/
env/
ENV/

# ---------------------------
# 테스트/커버리지/캐시
# ---------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/

# 타입체커/린터 캐시
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/

# ---------------------------
# 노트북
# ---------------------------
.ipynb_checkpoints/

# ---------------------------
# 로그/임시
# ---------------------------
logs/
*.log
*.tmp
*.temp
*.pid

# ---------------------------
# IDE/에디터
# ---------------------------
.vscode/
.idea/
*.code-workspace

# ---------------------------
# OS 특화 파일
# ---------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------
# 환경변수/시크릿
# ---------------------------
.env
.env.*
!.env.example   # 예시 파일은 커밋 유지

# ---------------------------
# (옵션) 데이터 디렉토리
# ---------------------------
data/
!data/.gitkeep

# ---------------------------
# 리포트/산출물(옵션)
# ---------------------------
coverage.xml
pytest-results.xml
